---
/**
 * Section after the hero on / — a one-glance map of what ZCOMMERZ does: Build · Sell · Manage · Grow.
 * Deliberately no product mockups: the hero already shows the product, and each capability has
 * its own section further down. Each card carries the verb (hero's mango underline), the full
 * product-team tool list (PRO marked) and a link to the section that shows it. The one-line
 * promise under each verb was removed 2026-11-10 at the user's request (pillarRows[].line kept, unused).
 * The title/intro/CTA header was removed 2026-11-10 at the user's request (pillarsTitle/pillarsIntro data kept, unused).
 * The Phase 3 tabbed showcase was replaced 2026-11-10 because every tab repeated another section.
 * /old keeps PillarsV1.
 */
import { ArrowDownRight } from '@lucide/astro';
import { pillarRows, pillarItems, pillarMore } from '../../data/pillars';
---
<section id="pillars" class="sec pillars" aria-label="What ZCOMMERZ does">
  <div class="page">
    <ol class="map" data-sr data-sr-stagger>
      {pillarRows.map((r) => (
        <li class="col">
          <h3 class="verb">
            <span data-bn={r.verb.bn}>{r.verb.en}</span>
            <svg class="stroke" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12.5C60 6 150 4 297 8.5" /></svg>
          </h3>
          <ul class="tools">
            {pillarItems[r.id].map((it) => <li><span data-bn={it.bn}>{it.en}</span>{it.pro && <em>PRO</em>}</li>)}
          </ul>
          <a class="go" href={r.href}><span data-bn={pillarMore[r.id].bn}>{pillarMore[r.id].en}</span><ArrowDownRight size={16} stroke-width={2} aria-hidden="true" /></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* equal space above and below the cards: the hero's stats strip already leaves 40px under it
     (.proof margin-bottom), so the top padding tops that up to one --sec-y */
  .pillars { padding: calc(var(--sec-y) - 40px) 0 var(--sec-y); background: var(--color-paper); }

  /* ---------- The map: four outline cards (border only, no shadow) ---------- */
  .map { display: grid; gap: 16px; }
  @media (min-width: 680px) { .map { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  @media (min-width: 1100px) { .map { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .col { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 24px 22px 26px; border: 1px solid var(--color-rule); border-radius: 16px; background: var(--color-paper); transition: border-color .25s ease; }
  @media (min-width: 1100px) { .col { padding: 28px clamp(20px, 1.8vw, 28px) 30px; } }
  .col:hover { border-color: #c9cfdb; }

  .verb { position: relative; width: fit-content; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 1.6rem + 1.6vw, 3rem); line-height: 1; letter-spacing: -0.04em; }
  :global(:lang(bn)) .verb { font-weight: 700; letter-spacing: 0; line-height: 1.15; }
  /* shorter and thinner underline (user, 2026-11-10): ~55% of the word, 3px stroke */
  .stroke { position: absolute; left: 0; bottom: -.14em; height: .12em; width: 55%; min-width: 1.6em; overflow: visible; }
  .stroke path { fill: none; stroke: var(--color-mango); stroke-width: 3; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 320; stroke-dashoffset: 0; }

  .tools { display: grid; gap: 8px; margin-top: 18px; }
  .tools li { display: flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--color-ink-2); }
  .tools li::before { content: ""; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--color-mango); }
  em { font-style: normal; padding: 1px 5px; border-radius: 4px; background: var(--color-ink); color: #fff; font-size: .58rem; font-weight: 800; letter-spacing: .04em; }

  .go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 14px; font-size: .9rem; font-weight: 650; color: var(--color-blue); width: fit-content; }
  .go :global(svg) { transition: transform .3s var(--ease-out-expo); }
  .go:hover { text-decoration: underline; text-underline-offset: 3px; }
  .go:hover :global(svg) { transform: translate(2px, 2px); }
  .go:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 3px; border-radius: 4px; }

  /* hovering a column redraws its underline */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .col:hover .stroke path { animation: redraw .7s var(--ease-out-expo); }
  }
  @keyframes redraw { from { stroke-dashoffset: 320; } to { stroke-dashoffset: 0; } }
</style>
