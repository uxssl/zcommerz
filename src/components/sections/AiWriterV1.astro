---
/**
 * E · AI product descriptions — an input desk feeding one big result.
 * Left (paper): the brief. Product thumbnail, name, keywords as removable tokens, tone and
 * language as segmented controls, one action. Fields are hairline-ruled, not boxed cards.
 * Right (night): the result on stage, set large — the only dark surface in the section, so
 * the generated copy is the thing the eye lands on. Typing, caret and copy feedback are GSAP.
 * Generation is the product-team's own template logic (src/data/sections.ts, verbatim strings);
 * nothing is sent anywhere.
 */
import SectionHead from './SectionHead.astro';
import TourRail from '../tour/TourRail.astro';
import { Sparkles, Check, Copy, ArrowRight, X } from '@lucide/astro';
import { aiHead, aiPoints, aiUi, aiTones, aiLangs, aiSteps, aiWalk, SIGNUP } from '../../data/sections';

const seedKw = ['raw', 'unfiltered', 'glass jar'];
const w = aiWalk;
---
<section id="ai" class="sec ai-sec" aria-labelledby="ai-title">
  <div class="page">
    <SectionHead id="ai-title" tag={aiHead.tag} h2={aiHead.h2} lead={aiHead.lead}>
      <a class="btn btn-primary" href={SIGNUP}><span data-bn={aiHead.cta.bn}>{aiHead.cta.en}</span><ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
    </SectionHead>

    <ul class="pts" data-sr>
      {aiPoints.map((p) => (
        <li><Check size={15} stroke-width={2.6} aria-hidden="true" /><span data-bn={p.bn}>{p.en}</span></li>
      ))}
    </ul>

    <!-- ---------- animated walkthrough ---------- -->
    <div class="walk" data-sr data-ai-tour role="region" aria-label="Animated walkthrough: AI product description" data-bn-aria-label="অ্যানিমেটেড ওয়াকথ্রু: AI পণ্যের বিবরণ">
      <div class="wk-bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="wk-ttl"><span data-bn={w.title.bn}>{w.title.en}</span> · <span data-bn={w.sample.bn}>{w.sample.en}</span></span>
      </div>

      <div class="wk-stage" data-tour-stage>
        <!-- ===== 0 · the brief ===== -->
        <div class="sc card" data-scene="0">
          <div class="c-head">
            <b data-bn={w.newProduct.bn}>{w.newProduct.en}</b>
            <span class="aibadge"><Sparkles size={11} stroke-width={2.2} aria-hidden="true" />AI</span>
          </div>
          <div class="c-form">
            <span class="pshot" data-a="shot"><img src="/assets/shop/honey.svg" alt="" width="80" height="80" /></span>
            <div class="c-fields">
              <span class="flab" data-bn={aiUi.name.bn}>{aiUi.name.en}</span>
              <span class="fbox"><em data-a="type" data-text="Mustard honey 500g"></em><i class="car" data-a="car"></i></span>
              <span class="flab" data-bn={aiUi.kw.bn.split(' (')[0]}>Keywords</span>
              <span class="fbox kwbox">{seedKw.map((k) => <b class="chipk" data-a="kw">{k}</b>)}</span>
              <span class="flab" data-bn={aiUi.tone.bn}>{aiUi.tone.en}</span>
              <span class="tonerow">{aiTones.map((t, i) => <b class:list={['chipt', i === 0 && 'on']} data-a="tone" data-bn={t.t.bn}>{t.t.en}</b>)}</span>
            </div>
          </div>
          <span class="wbtn" data-a="go"><Sparkles size={14} stroke-width={2.1} aria-hidden="true" /><span data-bn={aiUi.go.bn}>{aiUi.go.en}</span></span>
          <span class="rip" data-a="rip" aria-hidden="true"></span>
          <svg class="cur" data-a="cur" viewBox="0 0 24 24" fill="#fff" stroke="#0E1A2B" stroke-width="1.4" aria-hidden="true"><path d="M5 3l14 7.5-6 1.8-2.4 6.2L5 3z" /></svg>
        </div>

        <!-- ===== 1 · AI writes ===== -->
        <div class="sc two" data-scene="1" data-enter="wipe">
          <div class="card pcard">
            <span class="pshot big"><img src="/assets/shop/honey.svg" alt="" width="110" height="110" /></span>
            <b class="pname">Mustard honey 500g</b>
            <span class="pprice">৳650</span>
            <span class="kwrow">{seedKw.map((k) => <b class="chipk">{k}</b>)}</span>
          </div>
          <div class="card acard">
            <span class="a-state">
              <i class="sp" data-a="sp"><Sparkles size={13} stroke-width={2.1} aria-hidden="true" /></i>
              <b data-a="s1" data-bn={aiUi.writing.bn}>{aiUi.writing.en}</b>
              <b data-a="s2" data-bn={aiUi.ready.bn}>{aiUi.ready.en}</b>
            </span>
            <span class="sk" data-a="sk"><i style="width:92%"></i><i style="width:100%"></i><i style="width:74%"></i></span>
            <div class="a-lines">
              {w.lines.map((l) => <p data-a="ln">{l}</p>)}
            </div>
          </div>
        </div>

        <!-- ===== 2 · tone + language ===== -->
        <div class="sc two" data-scene="2" data-enter="wipe">
          <div class="card ctrl">
            <span class="ctl" data-bn={aiUi.tone.bn}>{aiUi.tone.en}</span>
            {aiTones.map((t, i) => <b class:list={['chipt', 'wide', i === 0 && 'on']} data-a={`t${i}`} data-bn={t.t.bn}>{t.t.en}</b>)}
            <span class="ctl sp2" data-bn={aiUi.lang.bn}>{aiUi.lang.en}</span>
            {aiLangs.map((l, i) => <b class:list={['chipt', 'wide', i === 0 && 'on']} data-a={`l${i}`}>{l.t}</b>)}
          </div>
          <div class="card acard">
            <span class="a-state"><i class="sp"><Sparkles size={13} stroke-width={2.1} aria-hidden="true" /></i><b data-bn={aiUi.ready.bn}>{aiUi.ready.en}</b></span>
            <div class="a-blocks">
              <p data-a="b0">{w.blocks.friendly}</p>
              <p data-a="b1">{w.blocks.festive}</p>
              <p data-a="b2" lang="bn">{w.blocks.festiveBn}</p>
            </div>
          </div>
        </div>

        <!-- ===== 3 · publish ===== -->
        <div class="sc card" data-scene="3" data-enter="wipe">
          <div class="c-head">
            <b>Mustard honey 500g</b>
            <span class="pubbtn" data-a="pub">
              <span class="p1" data-bn={w.publish.bn}>{w.publish.en}</span>
              <span class="p2"><Check size={13} stroke-width={3} aria-hidden="true" /><span data-bn={w.published.bn}>{w.published.en}</span></span>
            </span>
          </div>
          <div class="c-form pub">
            <span class="pshot big" data-a="pshot"><img src="/assets/shop/honey.svg" alt="" width="110" height="110" /></span>
            <div class="c-fields">
              <b class="pname" data-a="pb">Mustard honey 500g</b>
              <span class="pprice" data-a="pb">৳650</span>
              <p class="pdesc" data-a="pb"><span class="aibadge"><Sparkles size={11} stroke-width={2.2} aria-hidden="true" /><span data-bn={w.written.bn}>{w.written.en}</span></span>{w.blocks.friendly}</p>
            </div>
          </div>
          <span class="rip pubrip" data-a="rip" aria-hidden="true"></span>
          <svg class="cur" data-a="cur" viewBox="0 0 24 24" fill="#fff" stroke="#0E1A2B" stroke-width="1.4" aria-hidden="true"><path d="M5 3l14 7.5-6 1.8-2.4 6.2L5 3z" /></svg>
        </div>
      </div>

      <TourRail steps={aiSteps} label={w.label} />
    </div>
    <p class="fine walk-fine" data-bn={w.fine.bn}>{w.fine.en}</p>

    <h3 class="try-head" data-sr><Sparkles size={18} stroke-width={1.9} aria-hidden="true" /><span data-bn={w.tryHead.bn}>{w.tryHead.en}</span></h3>

    <div class="ai" data-sr data-ai>
      <!-- ---------- the brief ---------- -->
      <form class="desk" novalidate onsubmit="return false">
        <p class="step micro"><i>01</i><span data-bn="পণ্যের তথ্য">The product</span></p>

        <div class="prod">
          <span class="thumb" aria-hidden="true"><img src="/assets/shop/honey.svg" alt="" width="46" height="46" /></span>
          <span class="f f-name">
            <label for="aiName" data-bn={aiUi.name.bn}>{aiUi.name.en}</label>
            <input id="aiName" type="text" value="Mustard honey 500g" autocomplete="off" spellcheck="false" data-ai-name />
          </span>
        </div>

        <div class="f">
          <label for="aiKw" data-bn={aiUi.kw.bn}>{aiUi.kw.en}</label>
          <div class="kws" data-ai-kws>
            {seedKw.map((k) => (
              <span class="kw" data-kw={k}>{k}<button type="button" class="kx" data-kw-del aria-label={`Remove ${k}`}><X size={11} stroke-width={2.6} aria-hidden="true" /></button></span>
            ))}
            <input id="aiKw" type="text" autocomplete="off" spellcheck="false" placeholder="+ add" data-ai-kw />
          </div>
        </div>

        <p class="step micro"><i>02</i><span data-bn="কীভাবে লিখবে">How it should read</span></p>

        <div class="segrow">
          <div class="f">
            <span class="lbl" id="aiToneLbl" data-bn={aiUi.tone.bn}>{aiUi.tone.en}</span>
            <div class="seg" role="radiogroup" aria-labelledby="aiToneLbl" data-ai-tone>
              {aiTones.map((t, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-v={t.v} data-bn={t.t.bn}>{t.t.en}</button>
              ))}
            </div>
          </div>
          <div class="f">
            <span class="lbl" id="aiLangLbl" data-bn={aiUi.lang.bn}>{aiUi.lang.en}</span>
            <div class="seg" role="radiogroup" aria-labelledby="aiLangLbl" data-ai-lang>
              {aiLangs.map((l, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-v={l.v}>{l.t}</button>
              ))}
            </div>
          </div>
        </div>

        <button class="go" type="button" data-ai-go>
          <Sparkles size={17} stroke-width={1.9} aria-hidden="true" />
          <span data-bn={aiUi.go.bn}>{aiUi.go.en}</span>
        </button>
        <p class="fine" data-bn={aiHead.note.bn}>{aiHead.note.en}</p>
      </form>

      <!-- ---------- the result, on stage ---------- -->
      <div class="outstage">
        <div class="st-top">
          <span class="st-state" data-ai-state>
            <i class="sp" aria-hidden="true"><Sparkles size={13} stroke-width={2} /></i>
            <b data-bn={aiUi.out.bn}>{aiUi.out.en}</b>
          </span>
          <button class="cpy" type="button" data-ai-copy data-copy-bn={aiUi.copy.bn} data-copied={aiUi.copied.en} data-copied-bn={aiUi.copied.bn} disabled>
            <Copy size={14} stroke-width={1.9} aria-hidden="true" />
            <span data-cpy-lbl data-bn={aiUi.copy.bn}>{aiUi.copy.en}</span>
          </button>
        </div>

        <p class="out is-empty" data-ai-out aria-live="polite" data-bn={aiUi.empty.bn}>{aiUi.empty.en}</p>

        <div class="st-foot">
          <span class="meta" data-ai-meta aria-hidden="true"></span>
          <span class="pill" data-bn={aiUi.sample.bn}>{aiUi.sample.en}</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .ai-sec { padding: var(--sec-y) 0; background: var(--color-paper); }
  .ai { display: grid; gap: 22px; margin-top: var(--head-gap); align-items: start; }
  /* the stage takes its height from the desk beside it instead of holding a fixed block of dark */
  @media (min-width: 1000px) { .ai { grid-template-columns: minmax(0, 4.6fr) minmax(0, 7.4fr); gap: clamp(28px, 3.4vw, 52px); align-items: stretch; } }

  /* ---------- the brief ---------- */
  .desk { min-width: 0; }
  .step { display: flex; align-items: center; gap: 10px; color: var(--color-ink-2); }
  .step i { font-style: normal; font-weight: 700; color: var(--color-blue); letter-spacing: 0; }
  .step + * { margin-top: 14px; }
  .step:not(:first-child) { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--color-rule); }

  .prod { display: flex; align-items: flex-end; gap: 14px; }
  .thumb { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 12px; background: var(--color-paper-2); box-shadow: inset 0 0 0 1px var(--color-rule); }
  .thumb img { width: 42px; height: 42px; }
  .f { display: grid; gap: 6px; min-width: 0; }
  .f-name { flex: 1; }
  .f label, .lbl { font-size: .76rem; font-weight: 650; color: #8A91A0; }
  .f input {
    width: 100%; height: 38px; padding: 0 2px; border: 0; border-bottom: 1.5px solid var(--color-rule);
    background: transparent; font: inherit; font-size: 1rem; font-weight: 600; color: var(--color-ink);
    transition: border-color .2s;
  }
  .f input::placeholder { font-weight: 500; color: #B4BAC6; }
  .f input:focus { outline: 0; border-bottom-color: var(--color-blue); }

  .kws { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; min-height: 38px; padding: 5px 0; border-bottom: 1.5px solid var(--color-rule); }
  .kws:focus-within { border-bottom-color: var(--color-blue); }
  .kw { display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 5px 0 11px; border-radius: 7px; background: #EDF2FA; color: var(--color-blue); font-size: .82rem; font-weight: 650; }
  .kx { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; color: #7E9BC6; cursor: pointer; transition: background-color .15s, color .15s; }
  .kx:hover { background: #DCE7F7; color: var(--color-blue); }
  .kws input { flex: 1; min-width: 80px; height: 28px; border: 0; }

  .segrow { display: grid; gap: 16px; }
  @media (min-width: 520px) { .segrow { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); } }
  .seg { display: flex; gap: 4px; padding: 4px; border-radius: 11px; background: var(--color-paper-2); }
  .seg button {
    flex: 1; min-height: 34px; padding: 0 10px; border-radius: 8px; cursor: pointer;
    font-size: .84rem; font-weight: 600; color: var(--color-ink-2); white-space: nowrap;
    transition: background-color .2s, color .2s, box-shadow .2s;
  }
  .seg button:hover { color: var(--color-ink); }
  .seg button[aria-checked="true"] { background: #fff; color: var(--color-ink); font-weight: 700; box-shadow: 0 1px 2px rgb(14 26 43 / .14), 0 0 0 1px rgb(14 26 43 / .05); }

  .go {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; min-height: 50px; margin-top: 24px; padding: 0 20px; border-radius: 12px;
    background: var(--color-blue); color: #fff; font-size: 1rem; font-weight: 700; cursor: pointer;
    box-shadow: 0 14px 28px -16px rgb(42 93 168 / .95); transition: background-color .2s;
  }
  .go:hover { background: var(--color-blue-d); }
  .go :global(svg) { flex: none; }
  .go.busy { pointer-events: none; opacity: .82; }
  .fine { margin-top: 12px; font-size: .78rem; line-height: 1.5; color: #8A91A0; }

  /* ---------- the result on stage ---------- */
  .outstage {
    position: relative; display: flex; flex-direction: column; min-width: 0;
    min-height: 300px; padding: 18px clamp(18px, 2.2vw, 30px) 16px;
    border-radius: 20px; background: var(--color-navy); color: #fff;
    box-shadow: 0 40px 70px -44px rgb(7 11 36 / .75);
  }
  @media (min-width: 1000px) { .outstage { min-height: 328px; } }
  .st-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid var(--color-navy-rule); }
  .st-state { display: inline-flex; align-items: center; gap: 9px; font-size: .86rem; }
  .st-state .sp { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: rgb(255 255 255 / .1); color: var(--color-mango); }
  .st-state b { font-weight: 650; letter-spacing: -.01em; }
  .st-state.writing .sp { color: var(--color-mango); animation: pulse 1.1s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .st-state.writing .sp { animation: none; } }

  .cpy { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border-radius: 9px; cursor: pointer; background: rgb(255 255 255 / .08); color: #fff; font-size: .8rem; font-weight: 650; transition: background-color .2s, opacity .2s; }
  .cpy:hover { background: rgb(255 255 255 / .16); }
  .cpy[disabled] { opacity: .35; pointer-events: none; }
  .cpy.done { background: rgb(25 194 143 / .2); color: var(--color-mint); }

  .out {
    flex: 1; display: flex; align-items: center; margin: 0; padding: 20px 0;
    font-size: clamp(1.18rem, 1rem + .8vw, 1.72rem); line-height: 1.45; font-weight: 500;
    letter-spacing: -.012em; text-wrap: pretty;
  }
  :global(:lang(bn)) .out { letter-spacing: 0; line-height: 1.7; }
  .out.is-empty { color: rgb(255 255 255 / .34); font-weight: 400; }
  .out.typing::after { content: ""; display: inline-block; width: .08em; height: 1.05em; margin-left: .06em; translate: 0 .14em; background: var(--color-mango); animation: caret .8s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  .st-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 14px; border-top: 1px solid var(--color-navy-rule); }
  .meta { font-size: .78rem; color: var(--color-mist); font-variant-numeric: tabular-nums; }
  .pill { padding: 3px 10px; border-radius: 99px; background: rgb(255 255 255 / .08); color: var(--color-mist); font-size: .7rem; font-weight: 650; }

  /* ---------- points ---------- */
  .pts { display: grid; gap: 10px 28px; margin-top: clamp(22px, 2.4vw, 30px); padding-top: 18px; border-top: 1px solid var(--color-rule); }
  .pts + .walk { margin-top: clamp(24px, 2.8vw, 34px); }
  @media (min-width: 860px) { .pts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pts li { display: flex; align-items: flex-start; gap: 10px; font-size: .95rem; line-height: 1.45; color: var(--color-ink); }
  .pts :global(svg) { flex: none; margin-top: 3px; color: var(--color-blue); }

  /* ===================== animated walkthrough ===================== */
  .walk { min-width: 0; }
  .wk-bar { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: 16px 16px 0 0; background: #FAFBFC; box-shadow: 0 0 0 1px var(--color-rule); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #DFE3EB; }
  .wk-ttl { font-family: var(--font-ui); font-size: .78rem; color: #8A91A0; }

  .wk-stage {
    position: relative; container-type: inline-size; aspect-ratio: 16 / 7.05; min-width: 0;
    border-radius: 0 0 16px 16px; background: var(--color-paper-2); overflow: hidden;
    box-shadow: 0 0 0 1px var(--color-rule), 0 32px 60px -40px rgb(7 11 36 / .4);
    font-family: var(--font-ui); --u: 1cqw;
  }
  @media (max-width: 767.98px) { .wk-stage { aspect-ratio: 1 / 1.08; --u: 1.85cqw; } }
  .wk-stage img { display: block; max-width: none; }
  /* before the player takes over (no JS / first paint) scene 0 shows */
  .wk-stage [data-scene]:not([data-scene="0"]) { visibility: hidden; }
  .wk-stage.tour-ready [data-scene] { visibility: hidden; }
  .wk-stage.tour-ready [data-scene].is-active, .wk-stage.tour-ready [data-scene].is-leaving { visibility: visible; }
  /* scoped so the later .card rule can't win on position */
  .wk-stage > .sc { position: absolute; inset: calc(var(--u) * 4) calc(var(--u) * 5); }
  .wk-stage > .sc.two { display: grid; grid-template-columns: minmax(0, 26fr) minmax(0, 62fr); gap: calc(var(--u) * 3); }

  .card { position: relative; border-radius: calc(var(--u) * 1.6); background: #fff; padding: calc(var(--u) * 2.4) calc(var(--u) * 2.8); box-shadow: 0 0 0 1px #E8EBF1, 0 calc(var(--u) * 2) calc(var(--u) * 4) calc(var(--u) * -3) rgb(7 11 36 / .3); }
  .c-head { display: flex; align-items: center; justify-content: space-between; gap: calc(var(--u) * 2); padding-bottom: calc(var(--u) * 1.8); border-bottom: 1px solid #EEF0F4; }
  .c-head b { font-size: calc(var(--u) * 2); font-weight: 700; }
  .aibadge { display: inline-flex; align-items: center; gap: calc(var(--u) * .6); padding: calc(var(--u) * .4) calc(var(--u) * 1); border-radius: 99px; background: var(--color-blue); color: #fff; font-size: calc(var(--u) * 1.2); font-weight: 700; }
  .aibadge :global(svg) { width: calc(var(--u) * 1.3); height: calc(var(--u) * 1.3); }

  .c-form { display: grid; grid-template-columns: calc(var(--u) * 13) minmax(0, 1fr); align-items: start; gap: calc(var(--u) * 2.6); margin-top: calc(var(--u) * 2.2); }
  .sc.card { display: flex; flex-direction: column; }
  .sc.card .c-form { flex: 1; }
  .c-form.pub { grid-template-columns: calc(var(--u) * 18) minmax(0, 1fr); align-items: start; }
  .pshot { display: grid; place-items: center; width: calc(var(--u) * 13); height: calc(var(--u) * 13); border-radius: calc(var(--u) * 1.4); background: var(--color-paper-2); box-shadow: inset 0 0 0 1px #E8EBF1; }
  .pshot img { width: 78%; height: auto; aspect-ratio: 1; }
  .pshot.big { width: calc(var(--u) * 18); height: calc(var(--u) * 18); }
  .c-fields { display: grid; gap: calc(var(--u) * .7); min-width: 0; align-content: start; }
  .flab { font-size: calc(var(--u) * 1.25); font-weight: 650; color: #9AA1AF; }
  .flab + * { margin-bottom: calc(var(--u) * .9); }
  .fbox { display: flex; align-items: center; gap: calc(var(--u) * .8); min-height: calc(var(--u) * 3.6); padding: 0 calc(var(--u) * 1.2); border-radius: calc(var(--u) * .9); background: var(--color-paper-2); box-shadow: inset 0 0 0 1px #E8EBF1; font-size: calc(var(--u) * 1.5); font-weight: 600; }
  .fbox.kwbox { flex-wrap: wrap; padding: calc(var(--u) * .7) calc(var(--u) * 1); }
