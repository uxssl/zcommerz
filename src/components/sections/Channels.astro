---
/**
 * G · Channels. Navy, like the chat section, so the page alternates ground.
 * The integrations are laid out as the order's own path rather than a settings list:
 * where the sale comes from → how the money arrives → how the parcel leaves, with the
 * merchant's real connect controls living on each stage (clearly labelled as a demo).
 * The three claims from the product-team file close the section on hairlines.
 * All strings verbatim; the stage labels are the three stages themselves.
 */
import SectionHead from './SectionHead.astro';
import Logo from '../ui/Logo.astro';
import { Check, CreditCard, Wallet } from '@lucide/astro';
import { connHead, connPoints, connRows } from '../../data/sections2';
import { SIGNUP } from '../../data/sections';

const byId = Object.fromEntries(connRows.map((r) => [r.id, r]));
const stages = [
  { n: '01', t: { en: 'Channels', bn: 'চ্যানেল' }, ids: ['fb', 'dz', 'wa'] },
  { n: '02', t: { en: 'Payments', bn: 'পেমেন্ট' }, ids: ['ssl'] },
  { n: '03', t: { en: 'Delivery', bn: 'ডেলিভারি' }, ids: ['cr'] },
] as const;
const logoH = (k: string) => (k === 'daraz' ? '15px' : k === 'ecourier' ? '12px' : '20px');
---
<section id="channels" class="sec conn-sec on-navy" aria-labelledby="conn-title">
  <div class="page">
    <SectionHead id="conn-title" h2={connHead.h2} lead={connHead.lead} tone="dark">
      <a class="btn btn-primary" href={SIGNUP} data-bn="ফ্রি ট্রায়াল শুরু করুন">Start free trial</a>
    </SectionHead>

    <div class="flow" data-conn data-sr>
      {stages.map((st) => (
        <section class="lane" aria-label={st.t.en}>
          <header class="lh">
            <span class="ln" aria-hidden="true">{st.n}</span>
            <h3 data-bn={st.t.bn}>{st.t.en}</h3>
          </header>
          <ul>
            {st.ids.map((id) => {
              const r = byId[id];
              return (
                <li>
                  <span class="c-lg">
                    {r.logos.length
                      ? r.logos.map((k) => <Logo k={k} h={logoH(k)} label />)
                      : <><CreditCard size={18} stroke-width={1.7} aria-hidden="true" /><Wallet size={18} stroke-width={1.7} aria-hidden="true" /></>}
                  </span>
                  <button class="cbtn" type="button" aria-pressed={r.on ? 'true' : 'false'}
                    data-on={connHead.on.en} data-on-bn={connHead.on.bn} data-off={connHead.off.en} data-off-bn={connHead.off.bn}>
                    <span data-cbtn-lbl data-bn={r.on ? connHead.on.bn : connHead.off.bn}>{r.on ? connHead.on.en : connHead.off.en}</span>
                  </button>
                  <b class="c-nm">{r.name}</b>
                  <small class="c-s" data-bn={r.s.bn}>{r.s.en}</small>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <ul class="cpts" data-sr data-sr-stagger>
      {connPoints.map((p) => (
        <li>
          <Check size={15} stroke-width={2.6} aria-hidden="true" />
          <span><b data-bn={p.t.bn}>{p.t.en}</b><small data-bn={p.s.bn}>{p.s.en}</small></span>
        </li>
      ))}
    </ul>
    <p class="fine" data-bn={connHead.note.bn}>{connHead.note.en}</p>
  </div>
</section>

<style>
  .conn-sec { padding: var(--sec-y) 0; background: var(--color-navy); }

  /* ---------- the path an order takes ---------- */
  .flow { --gap: clamp(16px, 2vw, 28px); display: grid; gap: 14px; margin-top: var(--head-gap); }
  @media (min-width: 900px) {
    .flow { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap); align-items: start; }
  }

  .lane { position: relative; padding: 16px clamp(14px, 1.5vw, 18px) 8px; border-radius: 16px; background: rgb(255 255 255 / .04); box-shadow: inset 0 0 0 1px var(--color-navy-rule); }
  /* a chevron in the gutter: the stages read as one route, not three panels */
  @media (min-width: 900px) {
    .lane + .lane::before {
      content: ""; position: absolute; left: calc(var(--gap) / -2); top: 31px;
      width: 9px; height: 9px; translate: -50% -50%; rotate: 45deg;
      border-top: 1.6px solid rgb(255 255 255 / .34); border-right: 1.6px solid rgb(255 255 255 / .34);
    }
  }
  .lh { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--color-navy-rule); }
  .ln { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgb(255 255 255 / .08); color: var(--color-mist); font-family: var(--font-display); font-size: .72rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .lane:first-child .ln { background: var(--color-mango); color: #2A1B00; }
  .lh h3 { font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #fff; }
  :global(:lang(bn)) .lh h3 { letter-spacing: 0; text-transform: none; font-size: .98rem; }

  .lane ul { display: grid; }
  .lane li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3px 12px;
    padding: 14px 0;
  }
  .lane li + li { box-shadow: inset 0 1px 0 var(--color-navy-rule); }
  .c-lg { grid-column: 1; display: flex; align-items: center; gap: 8px; min-height: 20px; }
  .c-lg :global(.lg) { filter: brightness(0) invert(1); opacity: .92; }
  .c-lg :global(svg) { color: rgb(255 255 255 / .7); flex: none; }
  .cbtn {
    grid-column: 2; grid-row: 1 / span 2; align-self: center; justify-self: end;
    min-height: 32px; padding: 0 13px; border-radius: 9px; cursor: pointer;
    font-size: .8rem; font-weight: 650; color: #fff; white-space: nowrap;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .28); transition: background-color .2s, box-shadow .2s, color .2s;
  }
  .cbtn:hover { background: rgb(255 255 255 / .1); }
  .cbtn[aria-pressed="true"] { background: var(--color-mint); color: #06231A; box-shadow: none; }
  .c-nm { grid-column: 1; font-size: .95rem; font-weight: 650; color: #fff; }
  .c-s { grid-column: 1 / -1; margin-top: 2px; font-size: .84rem; line-height: 1.45; color: var(--color-mist); }

  /* ---------- the three claims ---------- */
  .cpts { display: grid; margin-top: clamp(26px, 3vw, 38px); border-top: 1px solid var(--color-navy-rule); }
  @media (min-width: 820px) { .cpts { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(24px, 3vw, 48px); } }
  .cpts li { display: flex; gap: 10px; padding: 16px 0; }
  @media (max-width: 819.98px) { .cpts li + li { border-top: 1px solid var(--color-navy-rule); } }
  .cpts :global(svg) { flex: none; margin-top: 3px; color: var(--color-mint); }
  .cpts span { display: grid; gap: 3px; }
  .cpts b { font-size: .98rem; font-weight: 650; color: #fff; }
  .cpts small { font-size: .86rem; line-height: 1.5; color: var(--color-mist); }

  .fine { padding-top: 14px; border-top: 1px solid var(--color-navy-rule); font-size: .8rem; color: var(--color-mist); }
</style>

<script>
  import { initConnections } from '../../scripts/connections';
  initConnections();
</script>
