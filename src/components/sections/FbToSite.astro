---
/**
 * F · Facebook page → website. The hero tour already plays this story end to end, so this
 * section states it rather than animating it a second time: three stages on one rail
 * (connect the page → one click → the site is live), each a small real fragment.
 * Strings verbatim from the product-team file.
 */
import SectionHead from './SectionHead.astro';
import Logo from '../ui/Logo.astro';
import { Check, ArrowRight, Lock } from '@lucide/astro';
import { videoHead, videoSteps } from '../../data/sections2';
import { SIGNUP } from '../../data/sections';

const ic = { 'stroke-width': 1.8, 'aria-hidden': 'true' } as const;
const [s1, s2, s3] = videoSteps;
---
<section id="video" class="sec fb-sec" aria-labelledby="fb-title">
  <div class="page">
    <SectionHead id="fb-title" h2={videoHead.h2} lead={videoHead.lead}>
      <a class="btn btn-primary" href={SIGNUP}><span data-bn="ফ্রি ট্রায়াল শুরু করুন">Start free trial</span><ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
    </SectionHead>

    <ol class="rail" data-sr data-sr-stagger>
      <!-- 1 · connect the page -->
      <li>
        <p class="rh"><span class="n">{s1.n}</span><b data-bn={s1.t.bn}>{s1.t.en}</b></p>
        <div class="box">
          <p class="bt" data-bn={s1.s.bn}>{s1.s.en}</p>
          <div class="pg on">
            <span class="av"><img src="/assets/logos/leaf.svg" alt="" width="20" height="20" /></span>
            <b>SSL Organic BD</b>
            <i class="tick"><Check size={12} stroke-width={3} aria-hidden="true" /></i>
          </div>
          <div class="pg">
            <span class="av"><img src="/assets/logos/shop.svg" alt="" width="20" height="20" /></span>
            <b data-bn="অন্য একটি পেজ">Another page</b>
            <i class="tick off"></i>
          </div>
          <span class="chan"><Logo k="facebook" h="16px" label /><Logo k="messenger" h="16px" label /></span>
        </div>
      </li>

      <!-- 2 · one click -->
      <li>
        <p class="rh"><span class="n">{s2.n}</span><b data-bn={s2.t.bn}>{s2.t.en}</b></p>
        <div class="box mid">
          <span class="found">
            <i><img src="/assets/logos/leaf.svg" alt="" width="26" height="26" /></i>
            <span><b>SSL Organic BD</b><small data-bn={s3.s.bn}>{s3.s.en}</small></span>
          </span>
          <span class="bigbtn" data-bn={s2.t.bn}>{s2.t.en}</span>
          <span class="prog" aria-hidden="true"><i></i></span>
          <p class="bt center" data-bn={s2.s.bn}>{s2.s.en}</p>
        </div>
      </li>

      <!-- 3 · live -->
      <li>
        <p class="rh"><span class="n">{s3.n}</span><b data-bn={s3.t.bn}>{s3.t.en}</b></p>
        <div class="box">
          <span class="addr"><Lock {...ic} />sslorganic.zcommerz.com<span class="live"><i></i><span data-bn="লাইভ">Live</span></span></span>
          <div class="mini">
            <span class="banner"><b data-bn="খামার থেকে সরাসরি">Fresh from the farm</b></span>
            <span class="row">
              <i><img src="/assets/shop/honey.svg" alt="" width="34" height="34" /></i>
              <i><img src="/assets/shop/ghee.svg" alt="" width="34" height="34" /></i>
              <i><img src="/assets/shop/rice.svg" alt="" width="34" height="34" /></i>
            </span>
          </div>
          <p class="bt" data-bn={videoHead.sample.bn}>{videoHead.sample.en}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .fb-sec { padding: var(--sec-y) 0; background: var(--color-paper-2); }
  /* a divided spread, not three cards: the stages are separated by rules and the
     product fragments sit straight on the paper */
  .rail { display: grid; margin-top: var(--head-gap); border-top: 1px solid var(--color-ink); }
  @media (min-width: 900px) { .rail { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .rail > li { display: grid; gap: 12px; align-content: start; padding: 20px 0 4px; }
  @media (min-width: 900px) {
    .rail > li { padding: 20px clamp(18px, 2.2vw, 32px) 4px; }
    .rail > li:first-child { padding-inline-start: 0; }
    .rail > li:last-child { padding-inline-end: 0; }
    .rail > li + li { border-left: 1px solid var(--color-rule); }
  }
  @media (max-width: 899.98px) { .rail > li + li { border-top: 1px solid var(--color-rule); } }

  .rh { display: flex; align-items: center; gap: 10px; }
  .n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--color-ink); color: #fff; font-size: .7rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .rh b { font-size: 1rem; font-weight: 700; letter-spacing: -.012em; }

  .box { display: grid; gap: 10px; align-content: start; min-height: 168px; font-family: var(--font-ui); }
  .box.mid { justify-items: center; align-content: center; text-align: center; }
  .bt { font-size: .8rem; color: #8A91A0; }
  .bt.center { margin-top: 2px; }

  .pg { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 9px 11px; border-radius: 10px; background: #fff; box-shadow: inset 0 0 0 1px var(--color-rule); font-size: .88rem; }
  .pg.on { box-shadow: inset 0 0 0 1.5px var(--color-blue); background: #F4F8FD; }
  .av { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--color-paper-2); box-shadow: inset 0 0 0 1px var(--color-rule); }
  .tick { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--color-blue); color: #fff; }
  .tick.off { background: transparent; box-shadow: inset 0 0 0 1.5px var(--color-rule); }
  .chan { display: flex; align-items: center; gap: 10px; margin-top: 2px; padding-top: 10px; border-top: 1px solid var(--color-rule); }
  .chan :global(.lg) { opacity: .78; }

  .found { display: flex; align-items: center; gap: 10px; padding: 9px 13px 9px 9px; border-radius: 99px; background: #fff; box-shadow: inset 0 0 0 1px var(--color-rule); }
  .found i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--color-paper-2); }
  .found span { display: grid; text-align: left; }
  .found b { font-size: .88rem; font-weight: 650; }
  .found small { font-size: .76rem; color: var(--color-ink-2); }
  .bigbtn { margin-top: 4px; padding: 11px 20px; border-radius: 11px; background: var(--color-blue); color: #fff; font-size: .92rem; font-weight: 700; box-shadow: 0 14px 26px -16px rgb(42 93 168 / .95); }
  .prog { display: block; width: 72%; height: 5px; border-radius: 99px; background: #E2E6EE; overflow: hidden; }
  .prog i { display: block; width: 68%; height: 100%; border-radius: 99px; background: var(--color-mango); }

  .addr { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; color: var(--color-ink-2); }
  .addr :global(svg) { width: 12px; height: 12px; color: #8A91A0; }
  .live { display: inline-flex; align-items: center; gap: 5px; margin-left: 4px; padding: 2px 8px; border-radius: 99px; background: #E2F6EE; color: #0F7A58; font-size: .68rem; font-weight: 700; }
  .live i { width: 5px; height: 5px; border-radius: 50%; background: var(--color-mint); }
  .mini { display: grid; gap: 8px; }
  .banner { display: grid; align-content: end; height: 62px; padding: 10px 12px; border-radius: 10px; background: radial-gradient(120% 90% at 85% 100%, #3D7D4D, #2F6B3F 60%); color: #FFF8E8; }
  .banner b { font-family: Georgia, serif; font-weight: 400; font-size: 1rem; }
  .mini .row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .mini .row i { display: grid; place-items: center; height: 54px; border-radius: 10px; background: #F7F2E6; }
</style>
