---
/**
 * F · Facebook page → website. Carries the Facebook story that used to open the hero
 * (moved here 2026-11-10 so the hero speaks to every seller): the product stage plays
 * scene 0 only — Facebook page → "Build my online business" → finished storefront — on a loop.
 * The three product-team steps sit under it as a slim caption row.
 * Strings verbatim from the product-team file.
 */
import SectionHead from './SectionHead.astro';
import StoreStage from '../tour/StoreStage.astro';
import { ArrowRight } from '@lucide/astro';
import { videoHead, videoSteps } from '../../data/sections2';
import { SIGNUP } from '../../data/sections';
---
<section id="video" class="sec fb-sec" aria-labelledby="fb-title" data-fb-tour>
  <div class="page">
    <SectionHead id="fb-title" h2={videoHead.h2} lead={videoHead.lead}>
      <a class="btn btn-primary" href={SIGNUP}><span data-bn="ফ্রি ট্রায়াল শুরু করুন">Start free trial</span><ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
    </SectionHead>

    <div class="fb-stage" data-sr role="region" aria-label="Animated walkthrough: Facebook page to website" data-bn-aria-label="অ্যানিমেটেড ওয়াকথ্রু: ফেসবুক পেজ থেকে ওয়েবসাইট">
      <StoreStage scenes={[0]} />
    </div>

    <ol class="steps" data-sr data-sr-stagger>
      {videoSteps.map((s) => (
        <li>
          <span class="n">{s.n}</span>
          <span class="txt"><b data-bn={s.t.bn}>{s.t.en}</b><small data-bn={s.s.bn}>{s.s.en}</small></span>
        </li>
      ))}
    </ol>
    <p class="sample" data-bn={videoHead.sample.bn}>{videoHead.sample.en}</p>
  </div>
</section>

<style>
  .fb-sec { padding: var(--sec-y) 0; background: var(--color-paper-2); }
  .fb-stage { margin-top: var(--head-gap); }

  .steps { display: grid; gap: 14px; margin-top: 28px; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 36px; } }
  .steps li { display: flex; align-items: flex-start; gap: 12px; }
  .n { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--color-ink); color: #fff; font-size: .7rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .txt { display: grid; gap: 2px; padding-top: 2px; }
  .txt b { font-size: 1rem; font-weight: 700; letter-spacing: -.012em; }
  .txt small { font-size: .88rem; color: var(--color-ink-2); }
  .sample { margin-top: 18px; font-size: .78rem; color: #8A91A0; }
</style>

<script>
  import { createTour } from '../../scripts/tour';
  import { heroScenes } from '../../scripts/hero-tour';

  const root = document.querySelector<HTMLElement>('[data-fb-tour]');
  if (root) {
    // One scene on a loop: a longer slot so the finished storefront holds before it rebuilds
    const tour = createTour(root, { duration: 6500, builders: heroScenes });
    tour.setReady(); // starts once the stage is ≥25% in view
    if (import.meta.env.DEV) (window as any).__fbTour = tour;
  }
</script>
