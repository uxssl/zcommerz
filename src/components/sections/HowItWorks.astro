---
/**
 * J · How it works. Four steps as a numbered rail: a hairline runs through the numbers so it
 * reads as one path, not four cards. Strings verbatim from the product-team file.
 */
import SectionHead from './SectionHead.astro';
import { ArrowRight } from '@lucide/astro';
import { howHead, howSteps } from '../../data/sections2';
import { SIGNUP } from '../../data/sections';
---
<section id="how" class="sec how-sec" aria-labelledby="how-title">
  <div class="page">
    <SectionHead id="how-title" h2={howHead.h2} lead={howHead.lead}>
      <a class="btn btn-primary" href={SIGNUP}><span data-bn="ফ্রি ট্রায়াল শুরু করুন">Start free trial</span><ArrowRight size={16} stroke-width={2} aria-hidden="true" /></a>
    </SectionHead>

    <ol class="steps" data-sr data-sr-stagger>
      {howSteps.map((s, i) => (
        <li>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 data-bn={s.t.bn}>{s.t.en}</h3>
          <p data-bn={s.s.bn}>{s.s.en}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how-sec { padding: var(--sec-y) 0; background: var(--color-paper-2); }
  .steps { position: relative; display: grid; gap: 26px; margin-top: var(--head-gap); }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px clamp(28px, 3.5vw, 56px); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(28px, 3.5vw, 56px); } }

  /* one continuous rail running behind the numbers, so the four steps read as a single
     path instead of four columns that each happen to start with a rule */
  @media (min-width: 1100px) {
    .steps::before {
      content: ""; position: absolute; left: 0; right: 0; top: 19px; height: 1px;
      background: linear-gradient(90deg, var(--color-ink) 0 18%, var(--color-rule) 34%, var(--color-rule) 100%);
    }
  }
  .steps li { position: relative; }
  .num {
    position: relative; display: grid; place-items: center; width: 38px; height: 38px; margin-bottom: 13px;
    border-radius: 50%; background: var(--color-paper-2); box-shadow: inset 0 0 0 1.5px var(--color-rule);
    font-family: var(--font-display); font-size: .84rem; font-weight: 800; color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .steps li:first-child .num { background: var(--color-blue); color: #fff; box-shadow: none; }
  /* below the rail breakpoint each step keeps its own hairline */
  @media (max-width: 1099.98px) {
    .steps li { padding-top: 20px; }
    .steps li::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--color-rule); }
    .steps li:first-child::before { background: var(--color-ink); }
  }
  .steps h3 { font-size: 1.08rem; font-weight: 700; line-height: 1.35; letter-spacing: -.012em; }
  :global(:lang(bn)) .steps h3 { letter-spacing: 0; line-height: 1.5; }
  .steps p { margin-top: 7px; font-size: .92rem; line-height: 1.5; color: var(--color-ink-2); max-width: 30ch; }
</style>
