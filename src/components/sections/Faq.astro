---
/**
 * L · FAQ. Native <details> on hairlines, first one open, as in the product-team file.
 * Questions and answers verbatim.
 */
import { Plus } from '@lucide/astro';
import { faqHead, faqs } from '../../data/sections2';
---
<section id="faq" class="sec faq-sec" aria-labelledby="faq-title">
  <div class="page faq-grid">
    <div class="faq-head" data-sr>
      <h2 id="faq-title" data-bn={faqHead.bn}>{faqHead.en}</h2>
    </div>
    <div class="faq" data-sr>
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span data-bn={f.q.bn}>{f.q.en}</span>
            <i aria-hidden="true"><Plus size={18} stroke-width={2} /></i>
          </summary>
          <p data-bn={f.a.bn}>{f.a.en}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-sec { padding: var(--sec-y) 0; background: var(--color-paper-2); }
  /* heading beside the list rather than above it: the questions start at the top of the
     section instead of after a band of empty paper */
  .faq-grid { display: grid; gap: var(--head-gap); }
  @media (min-width: 900px) {
    .faq-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); column-gap: clamp(40px, 6vw, 96px); align-items: start; }
    .faq-head { position: sticky; top: 104px; }
  }
  .faq-head h2 { font-size: var(--h2); font-weight: 800; line-height: 1.04; letter-spacing: -.035em; max-width: 12ch; }
  :global(:lang(bn)) .faq-head h2 { letter-spacing: 0; line-height: 1.22; font-weight: 700; }
  .faq { border-top: 1px solid var(--color-ink); }
  details { border-bottom: 1px solid var(--color-rule); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 20px 0; cursor: pointer; list-style: none;
    font-size: clamp(1rem, .95rem + .3vw, 1.14rem); font-weight: 650; line-height: 1.4; letter-spacing: -.012em;
  }
  :global(:lang(bn)) summary { letter-spacing: 0; line-height: 1.55; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-blue); }
  summary i { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--color-ink-2); box-shadow: inset 0 0 0 1px var(--color-rule); transition: transform .3s var(--ease-out-expo), background-color .2s, color .2s; }
  details[open] summary i { transform: rotate(45deg); background: var(--color-ink); color: #fff; box-shadow: none; }
  details p { max-width: 62ch; padding: 0 0 22px; font-size: .98rem; line-height: 1.6; color: var(--color-ink-2); }
  @media (prefers-reduced-motion: no-preference) {
    details[open] p { animation: faq-in .35s var(--ease-out-expo) both; }
  }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } }
</style>
