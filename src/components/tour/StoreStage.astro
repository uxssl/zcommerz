---
/**
 * Hero product stage: a phone and a browser separated by a seam.
 * The seam carries the product's core action, "Build my store", on a mango thread:
 * read as a still frame it says Facebook page → Build my store → storefront.
 *
 * Scenes (`data-scene="i"` groups, swapped inside both devices):
 *   0  phone = Facebook page   · window = store builds, then the finished store unmasks
 *   1  phone = store on mobile · window = same store, live (theme colours cycle)
 *   2  phone = order alerts    · window = merchant order list
 *   3  phone = Pathao tracking · window = checkout, paid by mobile wallet, secured by SSLCOMMERZ
 *      (the gateway row was added 2026-11-10 at the user's request; SSLCOMMERZ is named as the
 *      gateway in every payment list, per the branding rule)
 *   4  phone = Daraz shop      · window = same build as scene 0 (shared elements carry data-scene="0 4")
 * `scenes` picks which of these a stage carries (hero: 1–3; Facebook section: 0).
 * The resting/idle frame (no JS, reduced motion, before play) is the END of the first scene
 * (scene 0: Facebook page, seam button done, finished storefront; scene 1: the live storefront).
 * Copy, products and prices are verbatim from the product-team file (sample data).
 */
import Logo from '../ui/Logo.astro';
import Storefront from './Storefront.astro';
import { Search, ShoppingBag, LayoutGrid, Package, ShoppingCart, Users, Lock, ChevronLeft, ChevronRight, Check } from '@lucide/astro';

const products = [
  { img: 'honey', fb: 'Mustard honey 500g', store: 'Mustard honey', price: '৳650' },
  { img: 'ghee', fb: 'Ghee 500g', store: 'Pure ghee', price: '৳980' },
  { img: 'rice', fb: 'Red rice 5kg', store: 'Red rice 5kg', price: '৳540' },
];
const orders = [
  { ch: 'facebook', label: 'Facebook', line: '#1048 · Honey ×2', amt: '৳1,300' },
  { ch: 'daraz', label: '', line: '#1049 · Ghee 500g', amt: '৳980' },
  { ch: 'whatsapp', label: 'WhatsApp', line: '#1050 · Red rice 5kg', amt: '৳540' },
] as const;
const notes = [
  { ch: 'facebook', sub: 'Facebook · ৳1,300' },
  { ch: 'daraz', sub: 'Daraz · ৳980' },
  { ch: 'whatsapp', sub: 'WhatsApp · ৳540' },
] as const;
const track = [
  { en: 'Packed', bn: 'প্যাক হয়েছে' },
  { en: 'Picked up', bn: 'পিকআপ হয়েছে' },
  { en: 'On the way', bn: 'পথে আছে' },
  { en: 'Delivered', bn: 'পৌঁছে গেছে' },
];
const icon = { 'stroke-width': 1.8, 'aria-hidden': 'true' } as const;

interface Props {
  /** Which of the four scenes this stage carries (original indices). The first one is the resting frame. */
  scenes?: number[];
}
const { scenes = [0, 1, 2, 3] } = Astro.props;
const has = (n: number) => scenes.includes(n);
// Scenes 0 (Facebook) and 4 (Daraz) are the same "build" story with a different phone screen:
// the website skeleton, the seam button, the travelling photos and the cursor belong to both.
const buildIds = [0, 4].filter(has).join(' ');
const hasBuild = buildIds !== '';
---
<div class:list={['stage', !hasBuild && 'no-seam']} data-tour-stage data-scenes={scenes.join(',')} data-rest={scenes[0]}>
  <!-- ================= Browser window ================= -->
  <div class="win" data-a="win">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="nav-glyphs" aria-hidden="true"><ChevronLeft {...icon} /><ChevronRight {...icon} /></span>
      <span class="url-slot">
        {hasBuild && <span class="url" data-scene={buildIds}><Lock {...icon} /><span>xyzstore.zcommerz.com</span></span>}
        {has(1) && <span class="url" data-scene="1"><Lock {...icon} /><span data-a="url">xyzstore.zcommerz.com</span></span>}
        {has(2) && <span class="url" data-scene="2"><Lock {...icon} /><span>merchant.zcommerz.com</span></span>}
        {has(3) && <span class="url" data-scene="3"><Lock {...icon} /><span>xyzstore.zcommerz.com</span></span>}
      </span>
      <span class="live-slot">
        {has(1) && <span class="live" data-scene="1"><span data-a="live"><i></i><span data-bn="লাইভ">Live</span></span></span>}
        {has(3) && <span class="live" data-scene="3"><span><i></i><span data-bn="লাইভ">Live</span></span></span>}
      </span>
    </div>

    <div class="win-body">
      {hasBuild && (<Fragment><!-- 0/4 · Store builds from the page; ends on the finished storefront -->
      <div class="ws" data-scene={buildIds}>
        <div class="sf sf-skel">
          <div class="sf-head"><span class="sk sk-logo"></span><span class="sk-links"><span class="sk"></span><span class="sk"></span><span class="sk"></span></span><span class="sf-icons"><span class="sk sk-ic"></span><span class="sk sk-ic"></span></span></div>
          <div class="sf-ban sk-ban">
            <span class="ghost-text" data-bn="অনলাইন বিজনেস বানালে এখানে দেখা যাবে">Your online business appears here</span>
            <span class="sf-ban-art"><span class="sk sk-disc"></span></span>
          </div>
          <div class="sf-grid">
            {products.map((p) => (
              <div class="sf-card sk-card">
                <div class="sf-th"><img src={`/assets/products/${p.img}.svg`} alt="" width="64" height="64" data-a="tile" /></div>
                <span class="sk sk-line"></span>
                <span class="sf-row"><span class="sk sk-line short"></span><span class="sk sk-add"></span></span>
              </div>
            ))}
          </div>
          <div class="sf-pay"><span class="sk sk-chip"></span><span class="sk sk-chip"></span><span class="sk sk-chip"></span></div>
        </div>
        <div class="sf store built" data-a="built"><Storefront /></div>
      </div></Fragment>)}

      {has(1) && (<Fragment><!-- 1 · Live storefront -->
      <div class="ws sf store" data-scene="1" data-a="store">
        <Storefront animated />
        <div class="hint" data-a="hint"><span data-bn="থিম বদলাচ্ছে…">Switching themes…</span></div>
      </div></Fragment>)}

      {has(2) && (<Fragment><!-- 2 · Merchant orders -->
      <div class="ws md" data-scene="2" data-enter="wipe">
        <nav class="md-side" aria-hidden="true">
          <img src="/assets/logos/leaf.svg" alt="" width="20" height="20" />
          <span><LayoutGrid {...icon} /></span><span class="on"><ShoppingCart {...icon} /></span><span><Package {...icon} /></span><span><Users {...icon} /></span>
        </nav>
        <div class="md-main">
          <div class="ord" data-a="card">
            <div class="ph"><b data-bn="অর্ডার">Orders</b><span class="cnt" data-bn="৩টি নতুন">3 new</span></div>
            {orders.map((o) => (
              <div class="orow" data-a="orow">
                <span class="ch"><Logo k={o.ch} h="2.2cqw" label={!o.label} />{o.label}</span>
                <span class="line">{o.line}</span>
                <b>{o.amt}</b>
                <em data-bn="নতুন">New</em>
              </div>
            ))}
          </div>
          <div class="total" data-a="total"><small data-bn="আজকের বিক্রি">Today's sales</small><b>৳2,820</b></div>
        </div>
      </div></Fragment>)}

      {has(3) && (<Fragment><!-- 3 · Checkout -->
      <div class="ws sf store co-wrap" data-scene="3" data-enter="wipe">
        <div class="sf-head">
          <b class="sf-brand"><img src="/assets/logos/leaf.svg" alt="" width="20" height="20" />SSL Organic BD</b>
          <span class="sf-nav" data-bn="দোকান · অফার · কার্ট">Shop · Offers · Cart</span>
          <span class="sf-icons" aria-hidden="true"><Search {...icon} /><ShoppingBag {...icon} /></span>
        </div>
        <div class="co" data-a="card">
          <div class="ph"><b data-bn="চেকআউট">Checkout</b><span>#1048</span></div>
          <div class="amt" data-a="amt">৳1,300</div>
          <div class="pays">
            <div class="pc" data-a="pc" data-pc="bk" data-bn="মোবাইল ওয়ালেট">Mobile wallets</div>
            <div class="pc" data-a="pc" data-bn="কার্ড">Cards</div>
            <div class="pc" data-a="pc">Bangla QR</div>
          </div>
          <div class="gw" data-a="gw"><Lock {...icon} /><span data-bn="নিরাপদ পেমেন্ট:">Secured by</span><b class="gw-ssl">SSLCOMMERZ</b></div>
          <div class="paid" data-a="paid"><Check {...icon} /><span data-bn="পেমেন্ট পাওয়া গেছে">Payment received</span></div>
        </div>
      </div></Fragment>)}
    </div>
  </div>

  <!-- ================= Phone ================= -->
  <div class="phone" data-a="phone">
    <div class="screen">
      <span class="island" aria-hidden="true"></span>

      {has(0) && (<Fragment><!-- 0 · Facebook page -->
      <div class="ps ps-fb" data-scene="0">
        <div class="fb-top"><Logo k="facebook" h="7.5cqw" label /><span class="fb-search"></span></div>
        <div class="fb-cover"></div>
        <div class="fb-id">
          <span class="fb-av"><img src="/assets/logos/leaf.svg" alt="" width="40" height="40" /></span>
          <b>SSL Organic BD</b>
          <small data-bn="গ্রোসারি ও অর্গানিক ফুড">Grocery &amp; organic food</small>
          <span class="fb-acts" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <ul class="fb-posts">
          {products.map((p) => (
            <li data-a="post">
              <span class="th"><img src={`/assets/products/${p.img}.svg`} alt="" width="40" height="40" data-a="thumb" /></span>
              <span class="meta"><b>{p.fb}</b><small>{p.price}</small></span>
            </li>
          ))}
        </ul>
      </div></Fragment>)}

      {has(4) && (<Fragment><!-- 4 · Daraz shop (same products) -->
      <div class="ps ps-dz" data-scene="4">
        <div class="dz-top"><Logo k="daraz" h="5cqw" label /><span class="dz-search"></span></div>
        <div class="dz-shop">
          <span class="dz-av"><img src="/assets/logos/leaf.svg" alt="" width="40" height="40" /></span>
          <span class="dz-name"><b>SSL Organic BD</b><small data-bn="দারাজ শপ">Daraz shop</small></span>
        </div>
        <ul class="dz-grid">
          {products.map((p) => (
            <li data-a="post">
              <span class="th"><img src={`/assets/products/${p.img}.svg`} alt="" width="40" height="40" data-a="thumb" /></span>
              <b>{p.fb}</b>
              <small>{p.price}</small>
            </li>
          ))}
        </ul>
      </div></Fragment>)}

      {has(1) && (<Fragment><!-- 1 · Same store on mobile -->
      <div class="ps ps-store store" data-scene="1" data-a="mstore">
        <div class="m-head"><b><img src="/assets/logos/leaf.svg" alt="" width="16" height="16" />SSL Organic BD</b><span aria-hidden="true"><ShoppingBag {...icon} /></span></div>
        <div class="m-ban" data-a="mban">
          <b data-bn="খামার থেকে সরাসরি">Fresh from the farm</b>
          <span class="shop" data-bn="এখনই কিনুন">Shop now</span>
          <img src="/assets/products/honey.svg" alt="" width="80" height="80" />
        </div>
        <div class="m-grid">
          {products.map((p) => (
            <div class="sf-card" data-a="mitem">
              <div class="sf-th"><img src={`/assets/products/${p.img}.svg`} alt="" width="48" height="48" /></div>
              <b>{p.store}</b>
              <span class="sf-row"><small>{p.price}</small><span class="add" data-bn="যোগ করুন">Add</span></span>
            </div>
          ))}
        </div>
      </div></Fragment>)}

      {has(2) && (<Fragment><!-- 2 · Order notifications -->
      <div class="ps ps-notes" data-scene="2" data-enter="wipe">
        {notes.map((n) => (
          <div class="note" data-a="note">
            <span class="n-ic"><Logo k={n.ch} h={n.ch === 'daraz' ? '3.6cqw' : '7cqw'} label={n.ch === 'daraz'} /></span>
            <span class="n-txt"><b data-bn="নতুন অর্ডার">New order</b><small>{n.sub}</small></span>
          </div>
        ))}
      </div></Fragment>)}

      {has(3) && (<Fragment><!-- 3 · Delivery -->
      <div class="ps ps-trk" data-scene="3" data-enter="wipe">
        <div class="ph"><b data-bn="ডেলিভারি">Delivery</b><Logo k="pathao" h="7.5cqw" label /></div>
        <div class="m-order" data-a="morder"><span>#1048 · Honey ×2</span><b>৳1,300</b></div>
        <div class="tl-wrap">
          <span class="tl-line" aria-hidden="true"><i data-a="tline"></i></span>
          <ol class="tl">
            {track.map((t) => <li data-a="tli"><i></i><span data-bn={t.bn}>{t.en}</span></li>)}
          </ol>
        </div>
      </div></Fragment>)}
    </div>
  </div>

  {hasBuild && (<Fragment><!-- ================= The seam (scenes 0 and 4): the product's core action between the two devices ================= -->
  <span class="seam" data-scene={buildIds}>
    <span class="thread" aria-hidden="true"><i data-a="thread"></i></span>
    <span class="seam-btn" data-a="btn">
      <span class="fill" data-a="fill" aria-hidden="true"></span>
      <span class="lbl" data-bn="অনলাইন বিজনেস বানান">Build my online business</span>
      <span class="ok" data-a="ok" aria-hidden="true"><Check size={14} stroke-width={3} /></span>
    </span>
  </span>

  <!-- Scene 0 overlays: product photos travel across the seam; cursor presses the button -->
  <span class="fly-layer" data-scene={buildIds} aria-hidden="true">
    {products.map((p) => <img src={`/assets/products/${p.img}.svg`} alt="" width="64" height="64" data-a="fly" />)}
  </span>
  <span class="rip" data-scene={buildIds}><i data-a="rip"></i></span>
  <svg class="cur" data-scene={buildIds} viewBox="0 0 24 24" aria-hidden="true"><path data-a="cur" d="M5 3l14 7.5-6 1.8-2.4 6.2L5 3z" fill="#fff" stroke="#0E1A2B" stroke-width="1.4" stroke-linejoin="round"/></svg></Fragment>)}
</div>

<style is:global>
  /* ======================= Stage geometry =======================
     ≥768: phone | seam | browser side by side, both exactly the stage height.
           Widths in units of that height H: phone .46875H (9:19.2), gap .15H, browser 1.62H → stage 2.23875H.
     <768: browser full width on top (nothing covers the store), phone below overlapping its bottom-left edge,
           seam button in the free space right of the phone. */
  .stage {
    --phone-w: 20.94%;   /* .46875 / 2.23875 */
    --phone-top: 0%;
    --win-left: 27.64%;  /* (.46875 + .15) / 2.23875 */
    --seam-x: 24.29%;    /* centre of the gap */
    --seam-y: 33%;       /* banner height: the browser edge there is a solid colour block, the phone shows its cover */
    position: relative;
    aspect-ratio: 2.23875 / 1;
    isolation: isolate;
  }
  @media (max-width: 767.98px) {
    .stage { --phone-w: 44%; --phone-top: 38.7%; --win-left: 0%; --seam-y: 70.2%; --thread-l: -42%; --thread-w: 138%; --phone-left: 0%; aspect-ratio: 1 / 1.531; }
  }
  .stage .win {
    position: absolute;
    top: 0;
    left: var(--win-left);
    right: 0;
    aspect-ratio: 1.62; /* with the stage ratio above, height = stage height = phone height */
    container: win / inline-size;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(14 26 43 / .08),
      0 2px 4px rgb(14 26 43 / .04),
      0 24px 48px -28px rgb(7 11 36 / .28);
    overflow: hidden;
    z-index: 1;
  }
  @media (max-width: 767.98px) { .stage .win { border-radius: 12px; } .stage .sf { padding-left: 4cqw; } }
  .stage .phone {
    position: absolute;
    left: var(--phone-left, 0);
    top: var(--phone-top);
    width: var(--phone-w);
    aspect-ratio: 9 / 19.2;
    /* bezel ≈ 3.6% of the phone's own width (padding % resolves against the stage, so scale by --phone-w) */
    padding: calc(var(--phone-w) * .036);
    border-radius: 14% / 6.6%;
    background: linear-gradient(150deg, #33394a, #0b0e16 45%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / .16),
      0 24px 44px -24px rgb(7 11 36 / .45);
    z-index: 2;
  }
  .stage .screen {
    position: relative;
    height: 100%;
    container: phone / inline-size;
    border-radius: 11.5% / 5.4%;
    overflow: hidden;
    background: #fff;
  }
  .stage .island { position: absolute; top: 2.4%; left: 50%; width: 6.5%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; background: #0b0e16; box-shadow: inset 0 0 0 1.5px #1c2130; z-index: 5; } /* punch-hole camera */

  /* Scene groups. Before the player takes over (no JS, or first paint) scene 0 shows. */
  /* Resting frame without JS = the stage's first scene (data-rest) */
  .stage[data-rest="0"] [data-scene]:not([data-scene~="0"]),
  .stage[data-rest="1"] [data-scene]:not([data-scene~="1"]),
  .stage[data-rest="2"] [data-scene]:not([data-scene~="2"]),
  .stage[data-rest="3"] [data-scene]:not([data-scene~="3"]),
  .stage[data-rest="4"] [data-scene]:not([data-scene~="4"]) { visibility: hidden; }
  .stage.tour-ready [data-scene] { visibility: hidden; }
  .stage.tour-ready [data-scene].is-active, .stage.tour-ready [data-scene].is-leaving { visibility: visible; }
  .stage .ws, .stage .ps { position: absolute; inset: 0; }
  .stage img { display: block; max-width: none; }
  .stage .lg { display: inline-block; flex: none; }
  .stage svg.lucide { flex: none; }

  /* ======================= The seam ======================= */
  .stage .seam { position: absolute; left: var(--seam-x); top: var(--seam-y); z-index: 4; translate: -50% -50%; display: grid; place-items: center; }
  /* mobile: edges align with the page: phone on the left edge, button on the right edge */
  @media (max-width: 767.98px) { .stage .seam { left: auto; right: 0; translate: 0 -50%; } }
  .stage .thread { position: absolute; left: var(--thread-l, -55%); top: 50%; width: var(--thread-w, 162%); height: 2px; translate: 0 -50%; pointer-events: none; } /* long on the page side, stops just past the button on the store side */
  .stage .thread::before, .stage .thread::after { content: ""; position: absolute; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--color-mango); box-shadow: 0 0 0 3px #fff; }
  .stage .thread::before { left: -3px; }
  .stage .thread::after { right: -3px; }
  .stage .thread i { display: block; height: 100%; background: var(--color-mango); transform-origin: left; }
  .stage .seam-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px 11px 18px;
    border-radius: 99px;
    background: var(--color-mango);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: clamp(.78rem, .55rem + .45vw, .95rem);
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 0 0 4px #fff, 0 14px 26px -12px rgb(201 129 0 / .8);
  }
  @media (min-width: 768px) and (max-width: 1023.98px) { .stage .seam-btn { padding: 8px 11px 8px 13px; gap: 6px; } .stage .seam-btn .ok { width: 17px; height: 17px; } }
  .stage .seam-btn .fill { position: absolute; inset: 0; z-index: -1; background: var(--color-mint); transform-origin: left; }
  .stage .seam-btn .ok { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--color-ink); color: var(--color-mint); }

  /* ======================= Browser chrome ======================= */
  .stage .win-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2cqw;
    height: 6cqw;
    padding: 0 2.4cqw;
    background: #F4F5F8;
    border-bottom: 1px solid #E6E8EE;
    flex: none;
    font-family: var(--font-ui);
  }
  .stage .win-bar .dots { display: flex; gap: .9cqw; }
  .stage .win-bar .dots i { width: 1.2cqw; height: 1.2cqw; border-radius: 50%; background: #D7DAE2; }
  .stage .nav-glyphs { display: flex; gap: .4cqw; color: #A0A6B4; }
  .stage .nav-glyphs svg { width: 2.2cqw; height: 2.2cqw; }
  .stage .url-slot { position: relative; flex: 1; max-width: 44cqw; height: 3.8cqw; margin-inline: auto; }
  .stage .url {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center; gap: .8cqw;
    border-radius: .9cqw;
    background: #fff;
    box-shadow: 0 0 0 1px #E3E6EE;
    font-size: 1.65cqw;
    color: #2B3445;
    white-space: nowrap;
  }
  .stage .url svg { width: 1.5cqw; height: 1.5cqw; color: #8A91A0; }
  .stage .live-slot { position: relative; width: 9cqw; height: 3cqw; }
  .stage .live { position: absolute; inset: 0; display: flex; justify-content: flex-end; align-items: center; }
  .stage .live > span { display: inline-flex; align-items: center; gap: .7cqw; padding: .45cqw 1.2cqw; border-radius: 99px; background: #E2F6EE; color: #0F7A58; font-size: 1.45cqw; font-weight: 650; }
  .stage .live i { width: .9cqw; height: .9cqw; border-radius: 50%; background: var(--color-mint); box-shadow: 0 0 0 .5cqw rgb(25 194 143 / .2); }

  .stage .win-body {
    position: relative;
    flex: 1;
    overflow: hidden;
    font-family: var(--font-ui);
    font-size: 1.8cqw;
    line-height: 1.35;
    color: var(--color-ink);
    letter-spacing: 0;
  }

  /* ---------- Storefront: the merchant's own brand (serif wordmark + banner type) ---------- */
  .stage .store { --ta: #1E6B43; --tb: #F6F3EA; --tt: #ECE6D6; --serif: Georgia, "Times New Roman", serif; }
  .stage .sf { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 1.8cqw; padding: 2.4cqw 4cqw 2.8cqw 10cqw; background: var(--tb, #FAFBFC); }
  .stage .sf-head { display: flex; align-items: center; gap: 3cqw; height: 3.6cqw; }
