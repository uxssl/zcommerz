---
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ZCOMMERZ | Turn your Facebook page into an online store',
  description = 'Build your online store from your Facebook page. Ready themes, AI product descriptions, SSLCOMMERZ payments, Pathao and eCourier delivery, Daraz and WhatsApp, all from one dashboard.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <!-- Mark JS early so JS-only initial states never flash, and never hide content without JS -->
    <script is:inline>(function(d){d.classList.add('js');setTimeout(function(){d.classList.add('motion-ready')},3000)})(document.documentElement)</script>
  </head>
  <body>
    <a href="#main" class="sr-only-focusable fixed left-4 top-4 z-[100] rounded-md bg-ink px-4 py-3 text-white">Skip to content</a>
    <slot />
    <script>
      import { initLang } from '../scripts/i18n';
      initLang();
    </script>
  </body>
</html>
